{
	"name": "tf2dle",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "pnpm check:svelte && tsc --noEmit -p ./tsconfig.json",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:client": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:up": "docker compose -f docker-compose.dev.yaml up",
		"db:studio": "prisma studio",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:integration": "playwright test",
		"test:ui": "playwright test --ui",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@internationalized/date": "^3.8.1",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "^24.0.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"bits-ui": "2.19.5",
		"jsdom": "30.1.2",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "1.55.0",
		"@oslojs/crypto": "^1.0.1",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@types/node-schedule": "^2.1.8",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.0.0",
		"dayjs": "^1.11.18",
		"mode-watcher": "1.1.0",
		"node-schedule": "^2.1.1",
		"prisma": "7.10.0",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
