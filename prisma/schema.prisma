datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DailyMaps {
  id           Int      @id @default(autoincrement())
  selectedAt   DateTime @default(now()) @db.Date
  name         String
  startingPosX Float
  startingPosY Float
  hasWon       Int      @default(0)
}

model Logs {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  event     String
  message   String
}

model DailyWeapons {
  id         Int      @id @default(autoincrement())
  selectedAt DateTime @default(now()) @db.Date
  name       String
  hasWon     Int      @default(0)
}

model DailyWeaponsTwo {
  id          Int @id @default(autoincrement())
  selectedAt  DateTime @default(now()) @db.Date
  name        String
  hasWon      Int @default(0)
}

model DailyCosmetics {
  id         Int      @id @default(autoincrement())
  selectedAt DateTime @default(now()) @db.Date
  name       String
  thumbnail  String // Deprecated: No longer used, but keeping in-case we need to roll back
  rotation   Int
  usedBy     String
  hasWon     Int      @default(0)
}

model DailyUnusuals {
  id          Int @id @default(autoincrement())
  selectedAt  DateTime @default(now()) @db.Date
  name        String
  thumbnail   String // Deprecated: No longer used, but keeping in-case we need to roll back
  rotation    Int
  series      String
  hasWon      Int @default(0)
}

model DailyGameModeMetrics {
  id                 Int      @id @default(autoincrement())
  date               DateTime @db.Date
  gameMode           String
  starts             Int      @default(0)
  guesses            Int      @default(0)
  wins               Int      @default(0)
  totalGuessesToWin  Int      @default(0)

  @@unique([date, gameMode])
}

model DailyPageMetrics {
  id    Int      @id @default(autoincrement())
  date  DateTime @db.Date
  path  String
  views Int      @default(0)

  @@unique([date, path])
}

model AdminSettings {
  id                    Int      @id
  metricsLoggingEnabled Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}
